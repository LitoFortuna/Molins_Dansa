# Configuració de Firebase (client web).
# Copia aquest fitxer a `.env` i omple els valors des de la consola de Firebase:
#   Configuració del projecte  ›  Les teves aplicacions  ›  App web  ›  SDK setup and configuration
#
# El fitxer `.env` NO es puja al repositori (està a .gitignore).
# Aquestes claus són públiques per naturalesa (viatgen al bundle del navegador);
# la seguretat real la donen les regles de Firestore i App Check, no el secret d'aquestes claus.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=concurs-molins-dansa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=concurs-molins-dansa
VITE_FIREBASE_STORAGE_BUCKET=concurs-molins-dansa.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
